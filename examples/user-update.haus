// A partial update: only the fields that change are sent.
//
//   type UserUpdate = {
//     name?: String,              // optional: missing = not given
//     nickname?: Maybe String,    // not given, None (clear) or Some(…) (set)
//     address?: { street?: String, city?: String },
//   }
//
// Missing is never None and None is never missing (spec §1), so this says
// exactly one thing: clear the nickname, move to Paris, leave the rest alone.

{
  nickname: None,
  address: {
    city: "Paris",
  },
}
