// thread.schema.haus: a recursive type. A Comment's replies are Comments.
//
// Recursion is allowed but must be guarded (spec §9.9): every path from a
// type back to itself goes through a record field, an array element or a
// variant payload. Here it's `replies: Array Comment`, so each level of
// recursion consumes one level of the input, and decoding stays linear.
//
//   type Loop = Loop            // rejected: unguarded, never consumes input
//   type Wrapped = Maybe Wrapped // rejected for encoding: applies itself to the same value

import std/time (Instant)

type Comment =
  closed < Comment {
      author: String,
      at: Instant,
      text: String,
      likes: Int,
      replies: Array Comment,
    }
  >

type Root = Comment
