{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "contentMappers": [
    { "package": "@haus-fmt/import", "extensions": [".haus"], "options": { "target": "effect" } }
  ],
  "include": ["src"]
}
