  "devDependencies": {
    "@haus-fmt/import": "workspace:*",
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "typescript": "7.1.0-beta"
  },
  "dependencies": {
    "@haus-fmt/effect": "workspace:*",
    "effect": "4.0.6"
  }
}
