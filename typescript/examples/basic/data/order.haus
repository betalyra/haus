// A single order document.
{
  id: 1042,
  placedOn: Date("2026-11-07"),
  customer: {
    name: "Ada Lovelace",
    email: "ada@example.com",
    loyaltyTier: Gold,          // not in our schema: records are open, ignored
  },
  items: [
    { sku: "TEA-EARLGREY", quantity: 2, price: Money(7.90, EUR) },
    { sku: "MUG-HAUS",     quantity: 1, price: Money(14.50, EUR) },
  ],
  status: Shipped { at: Instant("2026-11-08T09:12:00Z"), tracking: Some("DHL-123456") },
  // note: Maybe String. Missing, so it decodes as undefined
}
