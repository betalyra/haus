  },
  "dependencies": {
    "@haus-fmt/haus": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.0.6"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@effect/vitest": "4.0.6",
    "@types/node": "24.10.1",
    "effect": "4.0.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
