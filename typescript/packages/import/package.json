{
  "name": "@haus-fmt/import",
  "version": "0.1.0",
  "description": "Import .haus files in TypeScript: typed imports (TypeScript 7.1 content mapper), a Node loader and a Vite plugin",
  "type": "module",
  "exports": {
    "./register": {
      "types": "./dist/register/plain.d.ts",
      "default": "./dist/register/plain.js"
    },
    "./register/effect": {
      "types": "./dist/register/effect.d.ts",
      "default": "./dist/register/effect.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./runtime/plain": {
      "types": "./dist/runtime/plain.d.ts",
      "default": "./dist/runtime/plain.js"
    },
    "./runtime/effect": {
      "types": "./dist/runtime/effect.d.ts",
      "default": "./dist/runtime/effect.js"
    }
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/typescript.js"
      ],
      "compilerOptions": [],
      "dynamicConfig": false
    }
  },
  "dependencies": {
    "@haus-fmt/haus": "workspace:*",
    "ts-content-mapper": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@haus-fmt/effect": "workspace:*",
    "effect": "4.0.6",
    "vite": "8.3.6",
    "vitest": "5.0.5",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@haus-fmt/effect": "workspace:*",
    "effect": "^4.0.6",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "@haus-fmt/effect": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register/*.js",
    "./dist/typescript.js"
  ]
}
