{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Haus Schema",
  "scopeName": "source.haus.schema",
  "patterns": [
    {
      "include": "source.haus#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "source.haus#string-triple"
    },
    {
      "include": "source.haus#quoted-key"
    },
    {
      "include": "source.haus#string"
    },
    {
      "include": "#type-decl"
    },
    {
      "include": "#optional-key"
    },
    {
      "include": "source.haus#key"
    },
    {
      "include": "#constructor"
    },
    {
      "include": "#type"
    },
    {
      "include": "source.haus#type-variable"
    },
    {
      "include": "source.haus#operators"
    }
  ],
  "repository": {
    "type-decl": {
      "match": "\\b(type)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.type.haus"
        },
        "2": {
          "name": "entity.name.type.declaration.haus"
        }
      }
    },
    "constructor": {
      "comment": "A variant arm: the tag right after `<` or `|`.",
      "match": "(?:(?<=<)|(?<=\\|))\\s*([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "constant.other.variant.haus"
        }
      }
    },
    "type": {
      "name": "entity.name.type.haus",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "optional-key": {
      "comment": "An optional field: `name?: T` (may be missing; never None).",
      "match": "\\b([a-z_][A-Za-z0-9_]*)(\\?)(?=\\s*:)",
      "captures": {
        "1": {
          "name": "support.type.property-name.haus"
        },
        "2": {
          "name": "keyword.operator.optional.haus"
        }
      }
    },
    "keywords": {
      "match": "\\b(closed|import)\\b|\\.\\.\\.",
      "name": "keyword.other.haus"
    }
  }
}
