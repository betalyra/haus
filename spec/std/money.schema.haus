// std/money: exact amounts with a currency.
//
//   import std/money (Money, Currency)

type Money = closed < Money Decimal Currency >          // Money(19.99, EUR)

// Any tag of three capital letters (the form of ISO 4217 codes). The module
// doesn't list the codes: new and non-ISO currencies (e.g. BTC as a
// convention) pass, and the application decides which ones it accepts.
type Currency = < >
