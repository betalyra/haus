// Each case decodes `input` with `type`. Ok: decoding succeeds, and encoding
// the result gives `output` (or `input` when there is no `output`), compared
// as values (§2). Err: decoding fails.

// ── Int: whole numbers by spelling, any size ──
Ok { type: "I", input: 0 },
Ok { type: "I", input: -42 },
Ok { type: "I", input: 0xFF, output: 255 },
Ok { type: "I", input: 1_000, output: 1000 },
Ok { type: "I", input: -0, output: 0 },
Ok { type: "I", input: 123456789012345678901234567890 },
Ok { type: "I", input: -123456789012345678901234567890 },
Err { type: "I", input: 1.0 },
Err { type: "I", input: 1e3 },
Err { type: "I", input: 1.5 },
Err { type: "I", input: "42" },
Err { type: "I", input: True },

// ── fixed-size integers: in range or an error ──
Ok { type: "I8", input: 127 },
Ok { type: "I8", input: -128 },
Err { type: "I8", input: 128 },
Err { type: "I8", input: -129 },
Ok { type: "U8", input: 255 },
Ok { type: "U8", input: -0, output: 0 },
Err { type: "U8", input: 256 },
Err { type: "U8", input: -1 },
Err { type: "U8", input: 1e2 },
Ok { type: "I64", input: 9223372036854775807 },
Ok { type: "I64", input: -9223372036854775808 },
Err { type: "I64", input: 9223372036854775808 },
Err { type: "I64", input: -9223372036854775809 },
Ok { type: "U64", input: 18446744073709551615 },
Err { type: "U64", input: 18446744073709551616 },

// ── Float64: nearest binary64, one spelling when written ──
Ok { type: "F64", input: 1 },
Ok { type: "F64", input: 1.0, output: 1 },
Ok { type: "F64", input: 0.10, output: 0.1 },
Ok { type: "F64", input: 100 },
Ok { type: "F64", input: 1e2, output: 100 },
Ok { type: "F64", input: 123000 },
Ok { type: "F64", input: 12.25 },
Ok { type: "F64", input: -1.5 },
Ok { type: "F64", input: 0.000001 },
Ok { type: "F64", input: 1e-7 },
Ok { type: "F64", input: 1.5e-7 },
Ok { type: "F64", input: 0.00000015, output: 1.5e-7 },
Ok { type: "F64", input: 1e20, output: 100000000000000000000 },
Ok { type: "F64", input: 1e21 },
Ok { type: "F64", input: 1.5e300 },
Ok { type: "F64", input: 0x10, output: 16 },
Ok { type: "F64", input: 0.30000000000000004 },
Ok { type: "F64", input: 0.1000000000000000055, output: 0.1 },
Ok { type: "F64", input: 5e-324 },
Ok { type: "F64", input: 3e-324, output: 5e-324 },
Ok { type: "F64", input: 2e-324, output: 0 },
Ok { type: "F64", input: 1e-400, output: 0 },
Ok { type: "F64", input: -1e-400, output: -0 },
Ok { type: "F64", input: -0 },
Ok { type: "F64", input: -0.0, output: -0 },
Ok { type: "F64", input: 1.7976931348623157e308 },
Ok { type: "F64", input: 1.7976931348623158e308, output: 1.7976931348623157e308 },
Err { type: "F64", input: 1.7976931348623159e308 },
Err { type: "F64", input: 1e400 },
Err { type: "F64", input: -1e400 },
Ok { type: "F64", input: NaN },
Ok { type: "F64", input: Infinity },
Ok { type: "F64", input: NegInfinity },
Err { type: "F64", input: NaN(1) },
Err { type: "F64", input: Inf },
Err { type: "F64", input: "1.5" },

// ── Float32: nearest binary32, directly from the decimal ──
Ok { type: "F32", input: 0.1 },
Ok { type: "F32", input: 1.5 },
Ok { type: "F32", input: 16777216 },
Ok { type: "F32", input: 16777217, output: 16777216 },
Ok { type: "F32", input: 1.0000001 },
// 1 + 2^-24 is halfway between two binary32 values. Rounding it as written
// gives 1 (ties to even); a hair above, it gives 1 + 2^-23. Rounding to
// binary64 first would land on the halfway point and wrongly give 1.
Ok { type: "F32", input: 1.000000059604644775390625, output: 1 },
Ok { type: "F32", input: 1.00000005960464477539062500000001, output: 1.0000001 },
Ok { type: "F32", input: 3.4028235e38 },
Ok { type: "F32", input: 3.40282356e38, output: 3.4028235e38 },
Err { type: "F32", input: 3.4028236e38 },
Err { type: "F32", input: 1e39 },
Ok { type: "F32", input: 1e-46, output: 0 },
Ok { type: "F32", input: -1e-46, output: -0 },
Ok { type: "F32", input: 1e21 },
Ok { type: "F32", input: NaN },
Ok { type: "F32", input: NegInfinity },

// ── Decimal: any number, kept exactly ──
Ok { type: "Dec", input: 19.90 },
Ok { type: "Dec", input: 0 },
Ok { type: "Dec", input: -0 },
Ok { type: "Dec", input: 1.5e3 },
Ok { type: "Dec", input: 1E+05, output: 1e5 },
Ok { type: "Dec", input: 0xFF, output: 255 },
Ok { type: "Dec", input: 123456789012345678901234567890.123456789 },
Err { type: "Dec", input: "19.90" },
Err { type: "Dec", input: NaN },

// ── ties: of two equally close shortest spellings, the even one ──
Ok { type: "F64", input: 1690060720831323.25, output: 1690060720831323.2 },
Ok { type: "F32", input: 2097152.25, output: 2097152.2 },
Ok { type: "F32", input: 2097152.75, output: 2097152.8 },
