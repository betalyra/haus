// Variants (spec §15): payload forms, open and closed, unknown values.
type Box = { w: Int }
type Shape = < Circle { r: Float64 } | Point Float64 Float64 | Empty | Wrap Box | Pair Int String >
type Level = closed < Debug | Info >
type Strict = closed < A | B Int | C { x: Int } >
type ClosedPayload = closed < Circle closed { r: Int } >
type AnyTag = < >
type Holder = { shape: Shape, any: Array AnyTag }
