---
/**
 * A landing-page section heading with a shareable `#id` link. Use it for every
 * section h2, and point the section's `aria-labelledby` at the same `id`.
 *
 * The heading itself is the link: on hover it gets the watercolour stroke and a
 * `#` appears in the margin to its left, without moving the text.
 */
interface Props {
  /** The anchor: short, lowercase, hyphenated (`/#trust`). */
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<h2 id={id} class:list={["section-heading text-[2.2rem] leading-[1.08] sm:text-[2.8rem]", className]}>
  <a href={`#${id}`} class="section-heading__link"
    ><span class="section-heading__hash" aria-hidden="true">#</span><span class="brush-hover section-heading__text"
      ><slot /></span
    ></a
  >
</h2>

<style>
  .section-heading {
    /* Leave room above the heading when the page jumps to it. */
    scroll-margin-top: 2rem;
  }
  .section-heading__link {
    position: relative;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  /* A thinner stroke than body links: at heading size 0.42em is a slab. */
  .section-heading__text {
    background-size: 0% 0.26em;
  }
  .section-heading__link:hover > .section-heading__text,
  .section-heading__link:focus-visible > .section-heading__text {
    background-size: 100% 0.26em;
  }
  /* Hangs in the margin, so the heading never moves. */
  .section-heading__hash {
    position: absolute;
    right: 100%;
    top: 50%;
    padding-right: 0.3em;
    font-size: 0.7em;
    font-weight: 400;
    color: var(--ink-3);
    opacity: 0;
    transform: translate(0.15em, -50%);
    transition:
      opacity 180ms ease-out,
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  .section-heading__link:hover > .section-heading__hash,
  .section-heading__link:focus-visible > .section-heading__hash {
    opacity: 1;
    transform: translate(0, -50%);
  }
  /* Not enough gutter on phones for the hash; the link still works. */
  @media (max-width: 40rem), (hover: none) {
    .section-heading__hash {
      display: none;
    }
  }
</style>
