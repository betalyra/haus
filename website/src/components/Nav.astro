---
import { PiGithubLogoLight } from "react-icons/pi";
import Logo from "./Logo.astro";
import { links } from "@/lib/links";

const items = [
  { label: "Spec", href: links.spec },
  { label: "Languages", href: "#languages" },
  { label: "Editors", href: links.editors },
];
---

<header class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 pt-6 pb-2 sm:pt-8">
  <a href="/" class="flex items-center gap-2.5" aria-label="haus, home">
    <Logo size={34} />
    <span class="text-[1.5rem] font-heading leading-none font-semibold tracking-[-0.025em] text-ink">haus</span>
  </a>

  <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
    {items.map((item) => (
      <a
        href={item.href}
        class="hidden px-2.5 py-1.5 text-[0.95rem] text-ink-2 sm:inline-block"
      >
        <span class="brush-hover">{item.label}</span>
      </a>
    ))}
    <a
      href={links.repo}
      class="ml-1 inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[0.95rem] text-ink"
    >
      <PiGithubLogoLight size={22} aria-hidden="true" />
      <span class="brush-hover">GitHub</span>
    </a>
  </nav>
</header>
