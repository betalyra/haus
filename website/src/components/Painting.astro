---
/**
 * A painted plate: the haus mark drawn large in ink, with loose washes laid in
 * behind it the way a line-and-wash sketch is coloured. The washes
 * deliberately miss the lines. `day` opens the page, `dusk` closes it.
 * The layers live in src/lib/painting.ts, shared with the Open Graph images.
 */
import Wash from "./Wash.astro";
import { mark } from "@/lib/mark";
import { inkWidth, layerSeed, smoke, washes, type Light } from "@/lib/painting";

interface Props {
  class?: string;
  light?: Light;
}

const { class: className, light = "day" } = Astro.props;

const titleId = `painting-${light}`;
---

<div class:list={["painting relative", className]}>
  {washes[light].map((layer, i) => (
    <Wash seed={layerSeed(light, i)} delay={layer.delay} soak class="inset-0 h-full w-full" strokes={layer.strokes} />
  ))}

  <!-- Smoke: two soft grey washes taking turns, each born small at the chimney,
       swelling as it rises and fading while the next one starts (.puff). -->
  {[0, 1].map((i) => (
    <div class:list={["puff", { "puff--2": i === 1 }]} aria-hidden="true">
      <Wash {...smoke(light, i)} instant class="inset-0 h-full w-full" />
    </div>
  ))}

  <svg class="relative h-full w-full" viewBox="-4 -8 72 72" fill="none" role="img" aria-labelledby={titleId}>
    <title id={titleId}>The haus mark: a little house with smoke rising from its chimney</title>
    <g stroke="var(--ink)" stroke-width={inkWidth} stroke-linecap="round" stroke-linejoin="round">
      <path d={mark.roof} />
      <path d={mark.chimney} />
      <path d={mark.body} />
      <circle cx={mark.window.cx} cy={mark.window.cy} r={mark.window.r} />
    </g>
  </svg>
</div>
