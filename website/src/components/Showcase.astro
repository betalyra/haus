---
import SectionHeading from "./SectionHeading.astro";
/**
 * "This is haus.": a home described device by device. The code morphs as the
 * text scrolls (the docs' Story component), and the card under it shows the
 * type haus works out on its own.
 */
import Story from "./docs/story/Story.astro";
import Step from "./docs/story/Step.astro";
import { homeSteps } from "@/content/samples";
---

<section class="relative mx-auto w-full max-w-6xl px-6 py-20 lg:py-32" aria-labelledby="this-is-haus">
  <div class="max-w-[40rem]">
    <SectionHeading id="this-is-haus">This is haus.</SectionHeading>
    <p class="mt-5 text-[1.12rem] text-ink-2">
      Describe your home, device by device. haus <strong>works out the types</strong> as you go. Hover any value to see
      what it sees.
    </p>
  </div>

  <div class="showcase-story">
    <Story types>
      <Step label="home.haus" code={homeSteps[0]!}>
        <h3>A light in the kitchen</h3>
        <p><code class="inline-code">Light</code> says what the device is, and carries its own settings.</p>
      </Step>
      <Step label="home.haus" code={homeSteps[1]!}>
        <h3>Add a thermostat</h3>
        <p>Another device, other settings. haus merges them: a device is <strong>a Light or a Thermostat</strong>.</p>
      </Step>
      <Step label="home.haus" code={homeSteps[2]!}>
        <h3>And the front door</h3>
        <p>A third case. No <code class="inline-code">type</code> field, no settings that only some devices fill in.</p>
      </Step>
      <Step label="home.haus" code={homeSteps[3]!}>
        <h3>Wake up at seven</h3>
        <p>
          <code class="inline-code">Time</code> is a real time of day. Only the kitchen has one, so it's
          <strong>optional</strong>: <code class="inline-code">wakeUp?</code>.
        </p>
      </Step>
    </Story>
  </div>
</section>

<style>
  .showcase-story :global(.story) {
    margin-top: 3.5rem;
  }
  .showcase-story :global(.story-step h3) {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .showcase-story :global(.story-step p) {
    color: var(--ink-2);
    max-width: 26rem;
  }
  @media (min-width: 72rem) {
    /* Short steps: a scroll of about a third of a screen moves to the next one. */
    .showcase-story :global(.story-step) {
      min-height: 30vh;
    }
    .showcase-story :global(.story__steps) {
      padding-top: 2vh;
      padding-bottom: 12vh;
    }
  }
</style>
