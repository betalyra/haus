---
import Code from "./Code.astro";
import Wash from "./Wash.astro";
import { heroHaus } from "@/content/samples";
import type { Pigment } from "@/lib/pigments";

const notes: { term: string; rest: string; color: Pigment }[] = [
  { term: "Shipped", rest: "is a variant. The status names its case and carries the data that goes with it.", color: "rose" },
  { term: "Date", rest: "is a real date, checked by every parser. No guessing what a string means.", color: "cerulean" },
  { term: "30.30", rest: "stays 30.30. Your code gets exactly what you wrote.", color: "gold" },
  { term: "None", rest: "means no value. Like True, it's a plain tag, so there's no null.", color: "sap" },
];
---

<section class="relative mx-auto w-full max-w-6xl px-6 py-20 lg:py-32" aria-labelledby="showcase-heading">
  <div class="max-w-[38rem]">
    <h2 id="showcase-heading" class="text-[2.2rem] leading-[1.08] sm:text-[2.8rem]">This is haus.</h2>
    <p class="mt-5 text-[1.12rem] text-ink-2">
      An order, written the way you'd describe it. If you can read JSON, <strong>you can read this</strong>.
    </p>
  </div>

  <div class="mt-14 grid grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="relative isolate lg:col-span-7">
      <Wash
        seed={8}
        class="-top-14 -left-16 -z-10 h-[calc(100%+7rem)] w-[calc(100%+8rem)]"
        strokes={[
          { x: 0.1, y: 0.22, rx: 0.12, ry: 0.22, color: "sap", strength: 0.9 },
          { x: 0.18, y: 0.1, rx: 0.13, ry: 0.11, color: "cerulean", strength: 0.75 },
          { x: 0.22, y: 0.9, rx: 0.14, ry: 0.09, color: "gold", strength: 0.9 },
          { x: 0.32, y: 0.93, rx: 0.07, ry: 0.06, color: "rose", strength: 0.7 },
        ]}
      />
      <Code code={heroHaus} lang="haus" label="order.haus" />
    </div>

    <ul class="space-y-7 lg:col-span-5">
      {notes.map((n, i) => (
        <li class="relative isolate pl-11">
          <Wash seed={40 + i} color={n.color} strength={1.4} class="top-[-0.2rem] left-[-0.4rem] -z-10 h-9 w-9" delay={i * 140} />
          <code class="inline-code">{n.term}</code> <span class="text-ink-2">{n.rest}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
