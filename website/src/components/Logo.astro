---
/**
 * The haus mark: a cozy little house drawn in one ink weight, with two puffs
 * of chimney smoke.
 */
import { mark } from "@/lib/mark";

interface Props {
  size?: number;
  class?: string;
  title?: string;
  strokeWidth?: number;
}

const { size = 40, class: className, title = "haus", strokeWidth = 3.2 } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 64 64" fill="none" role="img" aria-label={title}>
  <title>{title}</title>
  <g stroke="var(--ink)" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
    <path d={mark.roof} />
    <path d={mark.chimney} />
    <path d={mark.body} />
    <circle cx={mark.window.cx} cy={mark.window.cy} r={mark.window.r} stroke-width={strokeWidth * 0.8} />
  </g>
  <g fill="var(--ink)">
    {mark.puffs.map((p) => <circle {...p} />)}
  </g>
</svg>
