---
import SectionHeading from "./SectionHeading.astro";
import { PiArrowRightBold } from "react-icons/pi";
import Painting from "./Painting.astro";
import { links } from "@/lib/links";
---

<section class="relative mx-auto w-full max-w-6xl px-6 py-20 lg:py-32" aria-labelledby="try-it">
  <div class="grid grid-cols-1 items-center gap-14 md:grid-cols-12 md:gap-8 lg:gap-12">
    <div class="md:col-span-7">
      <SectionHeading id="try-it">Come on in.</SectionHeading>
      <p class="mt-5 max-w-[32rem] text-[1.12rem] text-ink-2">
        Take the five-minute tour, or paste your own data into the playground and see what haus makes of it.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-3 sm:gap-3">
        <a
          href={links.tour}
          class="inline-flex h-12 items-center gap-2 rounded-full bg-ink px-5 text-[0.98rem] max-[380px]:px-4 sm:px-6 sm:text-[1.02rem] font-medium text-paper transition-[background-color,transform] duration-200 ease-out hover:bg-ultramarine-ink active:translate-y-px"
        >
          Take the tour
        </a>
        {[
          { href: links.play, label: "Playground" },
          { href: links.install, label: "Install" },
          { href: links.repo, label: "GitHub" },
        ].map((l) => (
          <a href={l.href} class="group inline-flex h-12 items-center gap-1.5 px-3 text-[0.98rem] font-medium text-ink max-[380px]:px-1.5 sm:px-4 sm:text-[1.02rem]">
            <span class="brush-hover">{l.label}</span>
            <PiArrowRightBold size={16} aria-hidden="true" className="transition-transform duration-200 ease-out group-hover:translate-x-0.5" />
          </a>
        ))}
      </div>
    </div>
    <div class="md:col-span-5">
      <Painting light="dusk" class="mx-auto aspect-square w-[68%] max-w-[26rem] md:w-full" />
    </div>
  </div>
</section>
