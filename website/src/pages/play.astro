---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Wash from "@/components/Wash.astro";
import { PiLinkSimpleBold } from "react-icons/pi";
import "@/styles/play.css";

const outputs = [
  { key: "typescript", label: "Types in TypeScript", caption: "What TypeScript sees when your code imports these files (with @haus-fmt/import): one module per file." },
  { key: "json", label: "Values", caption: "What your program gets at runtime, written as JSON." },
  { key: "inferred", label: "Inferred schema", caption: "A schema that fits this data: a starting point for your own." },
  { key: "formatted", label: "Formatted", caption: "The data in the standard layout, comments kept." },
];
---

<Base
  title="Playground · haus"
  description="Write haus in your browser: errors as you type, types on hover, a schema to check against, and the TypeScript types and values your code gets."
>
  <Nav />
  <main id="main" class="mx-auto w-full max-w-7xl px-6 pt-6 pb-20 sm:pt-10">
    <div class="relative isolate flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
      <Wash
        seed={77}
        class="-top-8 -left-10 -z-10 h-28 w-56"
        strokes={[
          { x: 0.35, y: 0.5, rx: 0.3, ry: 0.32, color: "cerulean", strength: 0.7 },
          { x: 0.62, y: 0.42, rx: 0.16, ry: 0.2, color: "violet", strength: 0.5 },
        ]}
      />
      <div class="max-w-[40rem]">
        <h1 class="text-[2.2rem] leading-[1.08] sm:text-[2.8rem]">Playground</h1>
        <p class="mt-3 text-[1.05rem] text-ink-2">
          Write haus and add a schema if you like. Hover anything to see its type. It all runs in your browser.
        </p>
      </div>
      <div class="flex w-full items-center gap-2 sm:w-auto">
        <label class="sr-only" for="play-preset">Example</label>
        <select id="play-preset" class="play-select min-w-0 flex-1 sm:flex-none">
          <option value="" disabled>Your own</option>
        </select>
        <button id="play-share" type="button" class="play-button shrink-0">
          <PiLinkSimpleBold size={15} aria-hidden="true" />
          <span>Share</span>
        </button>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-5 lg:grid-cols-2">
      <div class="grid min-w-0 grid-rows-[auto_auto] gap-5">
        <section class="play-card" aria-label="Data">
          <header class="play-card__head"><span>data.haus</span></header>
          <div id="play-data" class="play-editor h-[22rem] lg:h-[26rem]"></div>
        </section>
        <section class="play-card" aria-label="Schema">
          <header class="play-card__head">
            <span>data.schema.haus</span>
            <label class="play-switch">
              <input id="play-use" type="checkbox" role="switch" checked />
              <span class="play-switch__track" aria-hidden="true"></span>
              <span>Check against schema</span>
            </label>
          </header>
          <div id="play-schema" class="play-editor h-[14rem] lg:h-[16rem]"></div>
        </section>
      </div>

      <section class="play-card flex min-w-0 flex-col" aria-label="Output">
        <header class="play-card__head flex-wrap gap-y-2">
          <div role="tablist" class="flex flex-wrap gap-x-4 gap-y-1">
            {outputs.map((o) => (
              <button type="button" role="tab" class="play-tab" data-output={o.key} data-caption={o.caption}>{o.label}</button>
            ))}
          </div>
          <button id="play-use-schema" type="button" class="play-link" hidden>Use as schema</button>
        </header>
        <p id="play-caption" class="play-caption"></p>
        <div id="play-output" class="play-editor min-h-[20rem] flex-1"></div>
        <p id="play-summary" class="play-summary" aria-live="polite"></p>
      </section>
    </div>

    <p class="mt-6 text-[0.92rem] text-ink-3">
      Types and values are those of the plain target of <code class="inline-code">@haus-fmt/import</code> (no Effect).
      Schema imports of packages like <code class="inline-code">@haus/money</code> don't work here yet;
      <code class="inline-code">std/time</code> does.
    </p>
  </main>
  <Footer />
</Base>

<script>
  import "@/lib/play/main";
</script>

