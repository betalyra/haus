---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Hero from "@/components/Hero.astro";
import Showcase from "@/components/Showcase.astro";
import Features from "@/components/Features.astro";
import InCode from "@/components/InCode.astro";
import Trust from "@/components/Trust.astro";
import TryIt from "@/components/TryIt.astro";
import Footer from "@/components/Footer.astro";
---

<Base
  title="haus: a data format that feels like home"
  description="Readable like a note, strict like a type system: haus is a data format with variants, exact numbers and real dates built in."
>
  <Nav />
  <main id="main">
    <Hero />
    <Showcase />
    <Features />
    <InCode />
    <Trust />
    <TryIt />
  </main>
  <Footer />
</Base>
