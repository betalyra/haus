// Profile @haus/geo/wgs84, version 1: latitude in [-90, 90], longitude in
// [-180, 180]. The values are haus text for the type LatLng.
Accept { value: "LatLng(38.7223, -9.1393)" },
Accept { value: "LatLng(90, 180)" },
Accept { value: "LatLng(-90, -180)" },
Reject { value: "LatLng(91, 0)", note: "latitude out of range" },
Reject { value: "LatLng(0, 180.5)", note: "longitude out of range" },
Reject { value: "LatLng(NaN, 0)" },
